{
  "name": "dsh-plugin-koishi",
  "version": "0.1.0",
  "description": "Authenticated Koishi message gateway for DeepSeek Harness agents.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pkgroll --sourcemap --packagejson=!package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "koishi",
    "plugin",
    "agent",
    "gateway"
  ],
  "homepage": "https://github.com/nazidada/dsh-plugin-koishi#readme",
  "bugs": {
    "url": "https://github.com/nazidada/dsh-plugin-koishi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazidada/dsh-plugin-koishi.git",
    "directory": "packages/dsh-plugin-koishi"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
